# Copia este archivo como .streamlit/secrets.toml (NO lo subas a GitHub) y pega tu llave.
# En Streamlit Cloud: App → Settings → Secrets, y pega la misma línea.
# Llave gratuita de Gemini: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY = "pega-aqui-tu-llave"
# Opcional (pagado): ANTHROPIC_API_KEY = "sk-ant-..."
